
/* ==========================================
   GBUBEMI ERICS - PROFESSIONAL PORTFOLIO
   Global Design System
========================================== */

:root {
    --background: #080f1e;
    --surface: #0e1829;
    --card: #111e32;
    --text: #f1f5f9;
    --muted: #a3b1c6;
    --primary: #60a5fa;
    --primary-dark: #2563eb;
    --secondary: #22d3ee;
    --border: rgba(148, 163, 184, 0.16);
    --header: rgba(8, 15, 30, 0.92);
    --shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
    --radius: 18px;
}

html[data-theme="light"] {
    --background: #ffffff;
    --surface: #f1f5f9;
    --card: #ffffff;
    --text: #0f172a;
    --muted: #475569;
    --primary: #1d4ed8;
    --primary-dark: #1d4ed8;
    --secondary: #0e7490;
    --border: rgba(15, 23, 42, 0.13);
    --header: rgba(255, 255, 255, 0.94);
    --shadow: 0 15px 40px rgba(15, 23, 42, 0.08);
}

/* RESET */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
}

body {
    font-family: 'Inter', Arial, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.7;
    overflow-x: hidden;
    transition: background 0.25s, color 0.25s;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font: inherit;
    cursor: pointer;
}

button:focus-visible,
a:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 5px;
}

[hidden] {
    display: none !important;
}

.container {
    width: min(90%, 1200px);
    margin-inline: auto;
}

.section {
    padding: 100px 0;
}

.alternate-section {
    background: var(--surface);
    border-block: 1px solid var(--border);
}

p {
    color: var(--muted);
}

h1, h2, h3 {
    line-height: 1.25;
    letter-spacing: -0.035em;
}

/* NAVIGATION */

.header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--header);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
}

.navbar {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.logo {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -2px;
}

.logo span {
    color: var(--primary);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--primary);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.icon-button {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 10px;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    transition: border-color 0.2s;
}

.icon-button:hover {
    border-color: var(--primary);
}

.menu-toggle {
    display: none;
}

/* HERO */

.hero {
    min-height: 660px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 70px;
    padding-block: 100px;
}

.eyebrow {
    display: inline-block;
    color: var(--primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(42px, 5.2vw, 76px);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.055em;
    margin-bottom: 22px;
}

.gradient-text {
    background: linear-gradient(
        110deg,
        var(--primary),
        var(--secondary)
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero h2 {
    font-size: clamp(20px, 2.3vw, 29px);
    font-weight: 600;
    margin-bottom: 20px;
}

.hero-description {
    font-size: 17px;
    max-width: 550px;
    line-height: 1.9;
    margin-bottom: 32px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
    transition: transform 0.2s, background 0.2s,
        border-color 0.2s;
}

.btn:hover {
    transform: translateY(-3px);
}

.btn-primary {
    background: var(--primary-dark);
    color: #ffffff;
    border: 1px solid var(--primary-dark);
}

.btn-primary:hover {
    background: #1e40af;
}

.btn-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    border-color: var(--primary);
}

.social-links {
    display: flex;
    gap: 14px;
    margin-top: 30px;
}

.social-links a {
    height: 42px;
    width: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 19px;
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s;
}

.social-links a:hover {
    color: var(--primary);
    border-color: var(--primary);
}

/* HERO ARCHITECTURE VISUAL */

.hero-visual {
    position: relative;
}

.hero-visual::before {
    content: "";
    position: absolute;
    inset: 10%;
    background: var(--primary);
    filter: blur(110px);
    opacity: 0.12;
    pointer-events: none;
}

.visual-card {
    position: relative;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--card);
    box-shadow: var(--shadow);
}

.visual-heading {
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 26px;
    font-weight: 600;
}

.status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 12px #22c55e;
}

.architecture-node {
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--background);
    padding: 18px;
}

.architecture-node i {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    font-size: 20px;
    color: var(--primary);
    background: rgba(59, 130, 246, 0.12);
    border-radius: 10px;
}

.architecture-node strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
}

.architecture-node small {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-top: 3px;
}

.connector {
    height: 20px;
    width: 2px;
    margin-inline: auto;
    background: var(--primary);
    opacity: 0.5;
}

.final-node {
    border-color: rgba(34, 197, 94, 0.4);
}

.final-node i {
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
}

/* PROFESSIONAL STATISTICS */

.stats-section {
    background: var(--surface);
    border-block: 1px solid var(--border);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-block: 35px;
}

.stat {
    text-align: center;
    padding: 15px;
    border-right: 1px solid var(--border);
}

.stat:last-child {
    border-right: none;
}

.stat strong {
    display: block;
    color: var(--primary);
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -1px;
}

.stat span {
    display: block;
    font-size: 12px;
    color: var(--muted);
}

/* SECTION HEADINGS */

.section-heading {
    max-width: 760px;
    margin-bottom: 45px;
}

.section-heading h2 {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 750;
    margin-bottom: 14px;
}

.section-heading p {
    font-size: 16px;
}

/* ABOUT */

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 65px;
    align-items: start;
}

.about-content p {
    font-size: 16px;
    margin-bottom: 22px;
    line-height: 1.9;
}

.text-link {
    color: var(--primary);
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 9px;
}

.text-link:hover {
    text-decoration: underline;
}

.about-highlights {
    display: grid;
    gap: 15px;
}

.highlight-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px 25px;
}

.highlight-card i {
    color: var(--primary);
    font-size: 22px;
    margin-bottom: 12px;
}

.highlight-card h3 {
    font-size: 17px;
    margin-bottom: 5px;
}

.highlight-card p {
    font-size: 13px;
}

/* PROJECT FILTERS */

.project-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 32px;
}

.filter-btn {
    padding: 9px 17px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    border-radius: 30px;
    font-weight: 500;
    transition: all 0.2s;
}

.filter-btn:hover,
.filter-btn.active {
    color: #ffffff;
    background: var(--primary-dark);
    border-color: var(--primary-dark);
}

/* PROJECT CARDS */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
}

.project-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s, box-shadow 0.25s,
        border-color 0.25s;
}

.project-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: var(--primary);
}

.project-visual {
    min-height: 185px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 25px 18px;
    color: #ffffff;
    background-size: 25px 25px;
}

.project-visual i {
    font-size: 37px;
    margin-bottom: 14px;
}

.project-visual span {
    font-size: 17px;
    font-weight: 700;
}

.project-visual small {
    font-size: 11px;
    color: #dbeafe;
    margin-top: 6px;
}

.blue-visual {
    background: linear-gradient(140deg, #0f2c59, #1d4ed8);
}

.green-visual {
    background: linear-gradient(140deg, #064e3b, #047857);
}

.purple-visual {
    background: linear-gradient(140deg, #312e81, #6d28d9);
}

.orange-visual {
    background: linear-gradient(140deg, #78350f, #b45309);
}

.cyan-visual {
    background: linear-gradient(140deg, #164e63, #0e7490);
}

.red-visual {
    background: linear-gradient(140deg, #7f1d1d, #b91c1c);
}

.project-content {
    padding: 25px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.project-category {
    font-size: 10px;
    color: var(--primary);
    font-weight: 700;
    letter-spacing: 1.2px;
    margin-bottom: 11px;
    display: block;
}

.project-content h3 {
    font-size: 20px;
    margin-bottom: 12px;
}

.project-content p {
    font-size: 14px;
    margin-bottom: 20px;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
}

.tags span {
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 500;
}

.project-content .tags {
    margin-top: auto;
}

.project-content .text-link {
    margin-top: 20px;
}

.section-action {
    text-align: center;
    margin-top: 40px;
}

/* TECHNICAL EXPERTISE */

.expertise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
}

.skill-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 30px;
}

.skill-card > i {
    color: var(--primary);
    font-size: 28px;
    margin-bottom: 20px;
}

.skill-card h3 {
    font-size: 21px;
    margin-bottom: 17px;
}

.skill-card p {
    font-size: 14px;
    line-height: 1.8;
}

/* CREDENTIALS */

.credentials-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

.credential-card {
    display: flex;
    align-items: center;
    gap: 22px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 28px;
}

.credential-card > i {
    font-size: 35px;
    color: var(--primary);
    flex-shrink: 0;
}

.credential-card h3 {
    font-size: 18px;
    margin-bottom: 7px;
}

.credential-card p {
    font-size: 13px;
}

/* RESEARCH */

.research-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
}

/* CONTACT */

.contact-section {
    background: var(--surface);
    border-top: 1px solid var(--border);
    text-align: center;
}

.contact-content {
    max-width: 800px;
}

.contact-content h2 {
    font-size: clamp(30px, 4.5vw, 48px);
    margin-bottom: 18px;
}

.contact-content p {
    font-size: 16px;
    max-width: 630px;
    margin: 0 auto 30px;
}

.contact-content .hero-buttons {
    justify-content: center;
}

/* FOOTER */

.footer {
    border-top: 1px solid var(--border);
    padding: 28px 0;
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.footer-content p {
    font-size: 12px;
    text-align: center;
}

/* TABLET RESPONSIVENESS */

@media (max-width: 1000px) {

    .nav-links {
        gap: 18px;
    }

    .hero {
        gap: 35px;
        min-height: auto;
        padding-block: 70px;
    }

    .projects-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-grid {
        gap: 35px;
    }

    .research-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}

/* MOBILE RESPONSIVENESS */

@media (max-width: 768px) {

    html {
        scroll-padding-top: 85px;
    }

    .container {
        width: 90%;
    }

    .section {
        padding-block: 65px;
    }

    .navbar {
        min-height: 68px;
    }

    .menu-toggle {
        display: grid;
    }

    .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        background: var(--background);
        border-bottom: 1px solid var(--border);
        padding: 15px 5%;
        box-shadow: var(--shadow);
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links a {
        display: block;
        padding: 12px 0;
    }

    .hero {
        grid-template-columns: 1fr;
        padding-block: 55px;
        gap: 40px;
    }

    .hero h1 {
        font-size: clamp(38px, 8vw, 60px);
    }

    .hero-description {
        font-size: 15px;
    }

    .visual-card {
        padding: 22px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .stat {
        border: none;
        padding: 10px;
    }

    .stat strong {
        font-size: 30px;
    }

    .about-grid,
    .expertise-grid,
    .credentials-grid,
    .research-grid {
        grid-template-columns: 1fr;
    }

    .footer-content {
        flex-direction: column;
        text-align: center;
    }

}

@media (max-width: 520px) {

    .projects-grid {
        grid-template-columns: 1fr;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-buttons .btn {
        width: 100%;
    }

    .project-visual {
        min-height: 170px;
    }

    .project-content {
        padding: 22px;
    }

    .credential-card {
        padding: 22px;
        gap: 16px;
    }

    .architecture-node {
        padding: 12px;
        gap: 10px;
    }

    .architecture-node strong {
        font-size: 13px;
    }

    .architecture-node small {
        font-size: 10px;
    }

}

/* ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *, *::before, *::after {
        animation: none !important;
        transition: none !important;
    }

}
